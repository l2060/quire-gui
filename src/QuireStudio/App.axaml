<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:QuireStudio.Presentation.ViewModels.Pages"
             xmlns:views="using:QuireStudio.Presentation.Views.Pages"
             x:Class="QuireStudio.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://QuireStudio/Presentation/Themes/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://QuireStudio/Presentation/Themes/Controls.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type pages:ProjectSettingsViewModel}">
      <views:ProjectSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:TagsViewModel}">
      <views:TagsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:ChangesViewModel}">
      <views:ChangesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:KeysViewModel}">
      <views:KeysView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:LogViewModel}">
      <views:LogView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type pages:GlobalSettingsViewModel}">
      <views:GlobalSettingsView />
    </DataTemplate>
  </Application.DataTemplates>

</Application>
