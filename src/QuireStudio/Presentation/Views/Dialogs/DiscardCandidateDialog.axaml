<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:QuireStudio.Presentation"
        xmlns:controls="using:QuireStudio.Presentation.Controls"
        x:Class="QuireStudio.Presentation.Views.Dialogs.DiscardCandidateDialog"
        Title="放弃候选"
        Width="480"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceRaisedBrush}"
        FontFamily="{DynamicResource UiFont}"
        FontSize="12.5"
        KeyDown="OnKeyDown">

  <Border Padding="0"
          Background="{DynamicResource SurfaceRaisedBrush}"
          BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
    <Grid RowDefinitions="Auto,Auto,Auto">

      <!-- 头部 -->
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="20,18,12,0"
            PointerPressed="OnHeaderPointerPressed" Background="Transparent">
        <Border Width="34" Height="34" CornerRadius="10"
                Background="{DynamicResource DangerSoftBrush}" VerticalAlignment="Top">
          <controls:IconPresenter Source="{x:Static ui:Icons.Alert}" Stroke="{DynamicResource DangerBrush}"
                                  StrokeThickness="1.8" Width="16" Height="16" />
        </Border>

        <StackPanel Grid.Column="1" Margin="12,0,8,0" Spacing="3" VerticalAlignment="Center">
          <TextBlock Text="放弃候选" FontSize="14" FontWeight="SemiBold" />
          <TextBlock Text="{Binding TagName}" Classes="mono" FontSize="11"
                     Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>

        <Button Grid.Column="2" Classes="icon" Click="OnCloseClick" VerticalAlignment="Top"
                IsTabStop="False" ToolTip.Tip="关闭">
          <controls:IconPresenter Source="{x:Static ui:Icons.Close}" Width="12" Height="12"
                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.9" />
        </Button>
      </Grid>

      <!-- 说明 -->
      <StackPanel Grid.Row="1" Margin="20,16,20,0" Spacing="12">
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="该构建记录会从发布链中移除，且无法恢复。已提交的基线不受影响。" />

        <Border CornerRadius="10" Padding="12,10" Background="{DynamicResource SurfaceSunkenBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
          <Grid ColumnDefinitions="Auto,*">
            <controls:IconPresenter Source="{x:Static ui:Icons.Folder}" Width="14" Height="14"
                                    Stroke="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Margin="9,0,0,0" Text="{Binding OutputSummary}"
                       FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextTertiaryBrush}" />
          </Grid>
        </Border>

        <CheckBox IsChecked="{Binding DeleteOutputs}" IsEnabled="{Binding HasOutputs}">
          <TextBlock Text="同时删除打包输出文件" FontSize="11.5" FontWeight="Normal" />
        </CheckBox>
      </StackPanel>

      <!-- 底部 -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="20,18,20,18">
        <TextBlock Text="不删除时输出仍保留在磁盘上，可手动清理" FontSize="10"
                   VerticalAlignment="Center" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="ghost" Content="取消" Command="{Binding CancelCommand}" />
          <Button Classes="danger" Content="放弃候选" Command="{Binding ConfirmCommand}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
