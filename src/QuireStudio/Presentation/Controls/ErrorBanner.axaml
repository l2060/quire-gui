<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:QuireStudio.Presentation"
             xmlns:controls="using:QuireStudio.Presentation.Controls"
             x:Class="QuireStudio.Presentation.Controls.ErrorBanner"
             IsVisible="{Binding HasError}">

  <Border CornerRadius="10" Padding="12,9"
          Background="{DynamicResource DangerSoftBrush}" BorderBrush="#4A1B28" BorderThickness="1"
          BoxShadow="0 10 30 0 #66000000">
    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
      <controls:IconPresenter Source="{x:Static ui:Icons.Alert}" Width="14" Height="14"
                              Stroke="{DynamicResource DangerBrush}" VerticalAlignment="Top"
                              Margin="0,2,0,0" />

      <TextBlock Grid.Column="1" Margin="10,0,12,0" Text="{Binding ErrorMessage}" FontSize="11"
                 TextWrapping="Wrap" MaxLines="4"
                 Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" />

      <Button Grid.Column="2" Classes="icon" Width="26" Height="26"
              Command="{Binding CopyErrorCommand}" ToolTip.Tip="复制错误信息">
        <controls:IconPresenter Source="{x:Static ui:Icons.Copy}" Width="13" Height="13"
                                Stroke="{DynamicResource DangerBrush}" />
      </Button>

      <Button Grid.Column="3" Classes="icon" Width="26" Height="26"
              Command="{Binding DismissErrorCommand}" ToolTip.Tip="关闭">
        <controls:IconPresenter Source="{x:Static ui:Icons.Close}" Width="12" Height="12"
                                Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.9" />
      </Button>
    </Grid>
  </Border>
</UserControl>
