<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:QuireStudio.Presentation.Controls"
             x:Class="QuireStudio.Presentation.Controls.LoadingOverlay"
             x:Name="Root"
             IsHitTestVisible="True">

  <UserControl.Styles>
    <!-- 旋转指示：动画普通 double 属性，避免 RenderTransform 无动画器的问题 -->
    <Style Selector="controls|SpinnerArc">
      <Style.Animations>
        <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="LinearEasing">
          <KeyFrame Cue="0%">
            <Setter Property="Angle" Value="0" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Angle" Value="360" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
  </UserControl.Styles>

  <Grid>
    <!-- 遮罩本身可命中，加载期间挡住下层的按钮与列表 -->
    <Border Background="{DynamicResource ScrimBrush}" Opacity="0.55" />

    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
            Background="{DynamicResource SurfaceRaisedBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            CornerRadius="14" Padding="22,18"
            BoxShadow="0 18 44 0 #55000000">
      <StackPanel Spacing="12" HorizontalAlignment="Center">
        <Grid Width="32" Height="32" HorizontalAlignment="Center">
          <Ellipse Width="32" Height="32"
                   Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="2.5" Opacity="0.45" />
          <controls:SpinnerArc Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5" />
        </Grid>

        <TextBlock Text="{Binding #Root.Message}"
                   FontSize="11.5" HorizontalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
